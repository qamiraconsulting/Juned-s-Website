# Copy to .env.local for local development. In production (Vercel), set
# these as project Environment Variables in the Vercel dashboard instead --
# never commit real values.

# Resend (transactional email for the Quote and Callback forms) -- SECRET,
# server-side only. Used by api/quote.ts and api/callback.ts, never exposed
# to the browser.
#
# RESEND_API_KEY: reuse the same key already set on the qamira-web Vercel
# project (Blue Line Removals doesn't have its own Resend account yet).
#
# LEAD_FROM_EMAIL: must be an address on a domain verified in Resend. Blue
# Line Removals doesn't have its own domain registered yet (2026-08-10), so
# this should be an address on Qamira's already-verified sending domain
# (the same one qamira-web's CONTACT_FROM_EMAIL uses), e.g.
# leads@mail.qamiraconsulting.com -- swap for a bluelineremovals.com.au
# address once that domain exists and is verified in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEAD_FROM_EMAIL=leads@mail.qamiraconsulting.com

# Where quote/callback leads are emailed to is NOT an env var -- it's the
# LEAD_TO_EMAIL constant hardcoded at the top of api/quote.ts and
# api/callback.ts (currently the agency's own inbox, since
# hello@bluelineremovals.com.au doesn't exist as a real mailbox yet).
# Update both constants directly once the client has a real inbox.
